# ==============================================================================
# Pixora — Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=8080
HOST=0.0.0.0
APP_ENV=development

# Static Asset Serving (Frontend compiled directory)
# In production container: /app/public
# In local development: ./frontend/dist (or served via Vite dev server)
STATIC_DIR=./frontend/dist

# ------------------------------------------------------------------------------
# Persistent Storage Architecture
# ------------------------------------------------------------------------------

# Container-internal photo storage root (Host bind-mount target)
# In production container: /media
# In local development: ./storage/media
# Read-Only Bind Mount Support:
#   The backend starts and operates normally if /media is mounted read-only (:ro).
#   Uploading photos or generating thumbnails requires write permissions, which
#   will be validated on-demand when invoked.
STORAGE_ROOT=./storage/media

# Container-internal SQLite database path (Separate persistent volume target)
# In production container: /data/pixora.db
# In local development: ./storage/data/pixora.db
# NOTE: The database directory must always be writable for SQLite transactions.
DATABASE_PATH=./storage/data/pixora.db

# Docker Compose Host Bind Mount Source (Host photo directory)
# Change to your actual photos directory on the host machine, for example:
# PIXORA_PHOTOS_DIR=/home/user/Pictures
PIXORA_PHOTOS_DIR=./storage/media

# Note on Host Permissions:
# The container runs as non-root user 'pixora' (UID: 1000, GID: 1000).
# For read-only browsing: host photos must be readable by UID 1000 (e.g. chmod -R a+rX).
# For write operations (future phases):
#   sudo chown -R 1000:1000 /home/user/Pictures
# or ensure read/write group permissions:
#   chmod -R u+rwX,g+rwX /home/user/Pictures
